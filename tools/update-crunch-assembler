#!/usr/bin/env python3
"""Update the in-tree assembler and linker from a pinned Git commit."""

import argparse
import hashlib
import pathlib
import re
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parents[1]
REVISION = pathlib.Path("vendor/crunch-assembler.rev")
HASHES = pathlib.Path("vendor/crunch-assembler.sha256")
UPSTREAM = "https://github.com/nkiiskin/crunch-assembler.git"


def git(*args, cwd=None):
    return subprocess.run(["git", *map(str, args)], cwd=cwd, check=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("commit", help="full 40-character upstream commit ID")
    parser.add_argument("--source", default=UPSTREAM,
                        help="upstream Git repository (default: published repository)")
    args = parser.parse_args()
    if not re.fullmatch(r"[0-9a-f]{40}", args.commit):
        parser.error("commit must be a full lowercase 40-character SHA-1")
    source = str(pathlib.Path(args.source).resolve()) if pathlib.Path(args.source).exists() else args.source

    entries = []
    for line in (ROOT / HASHES).read_text().splitlines():
        match = re.fullmatch(r"([0-9a-f]{64})  ([a-zA-Z0-9_.+/-]+)", line)
        if not match:
            raise ValueError("invalid checksum manifest")
        digest, name = match.groups()
        path = pathlib.PurePosixPath(name)
        if path.is_absolute() or ".." in path.parts or name in entries:
            raise ValueError(f"unsafe or duplicate path in manifest: {name}")
        if hashlib.sha256((ROOT / name).read_bytes()).hexdigest() != digest:
            raise ValueError(f"local vendored file differs from manifest: {name}")
        entries.append(name)
    if not entries:
        raise ValueError("empty checksum manifest")

    paths = [*entries, str(REVISION), str(HASHES)]
    if git("status", "--porcelain", "--untracked-files=no", "--", *paths, cwd=ROOT):
        raise ValueError("vendored files or pin metadata have uncommitted changes")

    with tempfile.TemporaryDirectory(prefix="crunch-assembler-update-") as directory:
        git("init", "--quiet", directory)
        git("fetch", "--quiet", "--no-tags", source, args.commit, cwd=directory)
        fetched = git("rev-parse", "FETCH_HEAD^{commit}", cwd=directory).decode().strip()
        if fetched != args.commit:
            raise ValueError("fetched revision does not match requested commit")
        contents = {name: git("show", f"{args.commit}:{name}", cwd=directory)
                    for name in entries}

    hashes = "".join(f"{hashlib.sha256(data).hexdigest()}  {name}\n"
                     for name, data in contents.items())
    for name, data in contents.items():
        (ROOT / name).write_bytes(data)
    (ROOT / HASHES).write_text(hashes)
    (ROOT / REVISION).write_text(args.commit + "\n")
    print(f"Updated vendored assembler and linker to {args.commit}.")
    print("Review changes and run standalone and compiler integration tests.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        detail = error.stderr.decode(errors="replace").strip() if (
            isinstance(error, subprocess.CalledProcessError) and error.stderr
        ) else str(error)
        print(f"update-crunch-assembler: {detail}", file=sys.stderr)
        sys.exit(1)
