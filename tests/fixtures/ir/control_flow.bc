int main() {
    if (0 && (1 / 0)) return 2;
    int total = 0;
    int i = 0;
    for (i = 0; i < 10; i++) {
        if (i == 7) break;
        total += i;
    }
    while (total < 42) {
        total++;
    }
    if (total == 42 && (1 || (1 / 0))) {
        return total;
    } else {
        return 1;
    }
}
