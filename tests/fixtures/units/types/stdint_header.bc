        INT_FAST16_MAX != INT64_MAX || UINTPTR_MAX != UINT64_MAX ||
        SIZE_MAX != UINT64_MAX || PTRDIFF_MIN != INT64_MIN) return 5;
    if (sizeof(INT8_C(1)) != 4 || sizeof(UINT8_C(1)) != 4 ||
