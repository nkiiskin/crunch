int matrix(int rows, int cols, int a[rows][cols]);

int matrix(int rows, int cols, int a[rows][cols]) {
    int i = 0;
    if (sizeof a != sizeof(void *) || sizeof *a != 12) return 1;
    if (sizeof a[i++] != 12 || i != 1) return 2;
    cols = 8;
    if (sizeof *a != 12 || (a + 1) - a != 1) return 3;
    a[1][2] = 42;
    return rows == 2 ? a[1][2] : 4;
}

int cube(int n, int m, int (*p)[n][m]) {
    if (sizeof *p != 24 || sizeof (*p)[0] != 12) return 1;
    p[1][1][2] = 42;
    return (p + 1) - p == 1 ? p[1][1][2] : 2;
}

int bound_effect(int n, int a[n++][3]) {
    return n == 3 && a[1][2] == 42 ? 42 : 1;
}

int inner_effect(int n, int a[2][n++]) {
    return n == 4 && sizeof *a == 12 && a[1][2] == 42 ? 42 : 1;
}

struct Shape { int rows; int cols; };

int shape(struct Shape s, int a[s.rows][s.cols]) {
    return sizeof *a == 12 && a[1][2] == 42 ? 42 : 1;
}

int dependent(int n, int a[2][n], int b[2][sizeof a[0]]) {
    b[1][11] = a[1][2];
    return b[1][11];
}

int main(void) {
    int a[2][3];
    int b[2][2][3];
    int c[2][12];
    struct Shape s = {2, 3};
    if (matrix(2, 3, a) != 42 || a[1][2] != 42) return 1;
    if (cube(2, 3, b) != 42 || b[1][1][2] != 42) return 2;
    if (bound_effect(2, a) != 42) return 3;
    if (inner_effect(3, a) != 42) return 4;
    if (shape(s, a) != 42 || dependent(3, a, c) != 42) return 5;
    return 42;
}
