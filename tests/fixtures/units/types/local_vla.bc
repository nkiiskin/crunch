struct Item { long value; int other; };

int basic(int n) {
    int a[n++];
    if (n != 4 || sizeof a != 12 || sizeof *(&a) != 12) return 1;
    n = 9;
    a[0] = 10;
    a[2] = 32;
    if (a[0] + a[2] != 42 || sizeof a != 12) return 2;
    int b[sizeof a];
    if (sizeof b != 48) return 3;
    struct Item items[n];
    items[1].value = 42;
    if (items[1].value != 42 || sizeof items != 144) return 4;
    int rows[n][3];
    rows[1][2] = 42;
    if (sizeof rows != 108 || rows[1][2] != 42) return 5;
    return 0;
}

int loops(int n) {
    int i = 0;
    for (i = 0; i < 3000; ++i) {
        int a[n];
        a[0] = i;
        if (i == 2999) break;
        if (i & 1) continue;
        {
            long b[n];
            b[0] = a[0];
            if (b[0] != i) return 1;
        }
    }
    if (i != 2999) return 2;
    for (int a[n]; i < 3001; ++i) {
        a[0] = 42;
        if (a[0] != 42) return 4;
    }
    i = 0;
    goto entry;
    while (i < 3) {
    entry: ;
        int a[n];
        a[0] = ++i;
        if (a[0] < 3) continue;
    }
    return i == 3 ? 0 : 3;
}

int jumps(int n) {
    int i = 0;
again: ;
    {
        int a[n];
        a[0] = ++i;
        if (i < 3000) goto again;
        goto done;
    }
done: ;
    goto inner;
    {
    inner: ;
        int a[n];
        a[0] = 42;
        if (a[0] != 42) return 1;
    }
    switch (n) {
    case 1:
        return 2;
    default: {
        int a[n];
        a[0] = 42;
        if (a[0] != 42) return 3;
        break;
    }
    }
    switch (n) {
    case 1:
        break;
    default: ;
        int a[n];
        a[0] = 42;
        if (a[0] != 42) return 4;
        break;
    }
    return 0;
}

int dimensions(void) {
    int rows = 2, cols = 3, depth = 4, i = 0;
    int a[rows++][cols++][depth++];
    if (rows != 3 || cols != 4 || depth != 5) return 1;
    rows = 8;
    cols = 9;
    depth = 10;
    a[1][2][3] = 42;
    if (sizeof a != 96 || sizeof a[i++] != 48 || i != 1) return 2;
    i = 0;
    if (sizeof a[0][i++] != 16 || i != 1) return 3;
    i = 0;
    if (sizeof a[i++][0][0] != 4 || i != 0) return 4;
    if ((a + 1) - a != 1 || a[1][2][3] != 42) return 5;
    int b[2][cols][3];
    b[1][8][2] = 42;
    if (sizeof b != 216 || sizeof b[0] != 108 || b[1][8][2] != 42) return 6;
    i = 0;
    if (sizeof *(&b[i++]) != 108 || i != 1) return 8;
    int c[rows][3][cols];
    c[1][2][8] = 42;
    i = 0;
    if (sizeof c[i++][0] != 36 || i != 1 || c[1][2][8] != 42) return 9;
    _Alignas(16) double aligned[rows][cols];
    aligned[1][1] = 42.0;
    if (aligned[1][1] != 42.0) return 7;
    return 0;
}

int matrix_loops(int n, int m) {
    int i = 0;
again: ;
    {
        int a[n][m];
        a[n - 1][m - 1] = 42;
        if (a[n - 1][m - 1] != 42) return 1;
        if (++i < 3000) goto again;
    }
    for (i = 0; i < 3000; ++i) {
        int a[n][m];
        a[0][0] = i;
        if (i & 1) continue;
        if (a[0][0] != i) return 2;
    }
    return 0;
}

int pointer_rows(void) {
    int rows = 3, cols = 4;
    int a[rows][cols];
    int (*p)[cols++] = a;
    if (cols != 5 || sizeof p != sizeof (void *) || sizeof *p != 16) return 1;
    cols = 9;
    p[1][3] = 42;
    if (a[1][3] != 42 || (p + 2) - p != 2) return 2;
    p += 1;
    if ((*p)[3] != 42 || sizeof *p++ != 16 || p != a + 2) return 3;
    --p;
    if (sizeof p++ != sizeof (void *) || p != a + 1) return 4;
    _Alignas(16) int (*aligned)[cols] = 0;
    if (sizeof *aligned != 36) return 5;
    return 0;
}

int pointer_dimensions(void) {
    int n = 2, m = 3, count = 0;
    int a[2][n][m];
    int (*p)[n++][m++] = a;
    if (n != 3 || m != 4 || sizeof *p != 24 || sizeof (*p)[0] != 12) return 1;
    p[1][1][2] = 42;
    if (a[1][1][2] != 42 || (p + 1) - p != 1) return 2;
    if (sizeof p[count++][0] != 12 || count != 1) return 3;
    int (*q)[2][m][3] = 0;
    if (sizeof *q != 96 || sizeof (*q)[0] != 48) return 4;
    return 0;
}

int main(void) {
    if (basic(3)) return 1;
    if (loops(1024)) return 2;
    if (jumps(1024)) return 3;
    if (dimensions()) return 4;
    if (matrix_loops(32, 32)) return 5;
    if (pointer_rows()) return 6;
    if (pointer_dimensions()) return 7;
    return 42;
}
