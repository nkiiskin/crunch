enum { COLS = 3 };
typedef int (*Row)[COLS];
struct Grid { int (*rows)[COLS]; };
int (*global_rows)[COLS];

int element(int (*p)[COLS]) {
    return p[1][2];
}

int main(void) {
    static int data[2][COLS] = {{1, 2, 3}, {4, 5, 6}};
    int (*const p)[COLS] = data;
    Row row = p + 1;
    struct Grid grid = {data};
    int (*call)(int (*)[COLS]) = element;
    void *raw = data;
    int (*cast)[COLS] = (int (*)[COLS])raw;
    global_rows = data;
    if (sizeof(int (*)[COLS]) != sizeof(void *) || sizeof(*p) != 12)
        return 1;
    if ((*row)[2] != 6 || grid.rows[1][2] != 6 || cast[1][2] != 6 ||
        global_rows[1][2] != 6)
        return 2;
    if (call(data) != 6)
        return 3;
    return 42;
}
