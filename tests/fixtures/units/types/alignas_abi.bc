struct Unit { _Alignas(16) double value; };
struct Pair { _Alignas(16) int first; int second; double value; };
struct Big { char first; _Alignas(16) int value; char last; };
struct Unit host_unit(struct Unit value);
struct Pair host_pair(struct Pair value);
struct Big host_big(struct Big value);
int host_checks(void);

struct Unit crunch_unit(struct Unit value) { value.value += 2.0; return value; }
struct Pair crunch_pair(struct Pair value) { value.first += 3; return value; }
struct Big crunch_big(struct Big value) { value.value += 4; return value; }

int main(void) {
    struct Unit u = {1.0};
    struct Pair p = {2, 3, 4.0};
    struct Big b = {5, 6, 7};
    u = host_unit(u);
    p = host_pair(p);
    b = host_big(b);
    if (u.value != 11.0 || p.first != 12 || p.second != 3 ||
        p.value != 4.0 || b.first != 5 || b.value != 16 || b.last != 7)
        return 1;
    return host_checks() == 0 ? 42 : 2;
}
