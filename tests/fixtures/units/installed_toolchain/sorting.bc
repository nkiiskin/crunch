#include <stdio.h>

int main() {
    int numbers[5] = {9, 2, 5, 1, 7};
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 4 - i; j++) {
            if (numbers[j] > numbers[j + 1]) {
                int temp = numbers[j];
                numbers[j] = numbers[j + 1];
                numbers[j + 1] = temp;
            }
        }
    }
    printf("sort:%d,%d,%d,%d,%d\n", numbers[0], numbers[1], numbers[2], numbers[3], numbers[4]);
    return numbers[0] == 1 && numbers[4] == 9 ? 0 : 1;
}
