#include <sys/mman.h>
#include <errno.h>

int main() {
    char* bad = mmap(0, 4096, PROT_READ, MAP_PRIVATE, -1, 0);
    if (!map_failed(bad) || errno != EBADF) return 1;
    bad = mmap(0, 4096, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS, -1, 1);
    if (!map_failed(bad) || errno != EINVAL) return 2;

    char* region = mmap(0, 8192, PROT_READ | PROT_WRITE,
                        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (map_failed(region)) return 3;
    region[0] = (char)42;
    errno = 0;
    if (munmap(region + 1, 4096) != -1 || errno != EINVAL || region[0] != 42) return 4;
    errno = 0;
    bad = mremap(region, 8192, 4096, MREMAP_FIXED, 0);
    if (!map_failed(bad) || errno != EINVAL || region[0] != 42) return 5;
    errno = ERANGE;
    char* shrunk = mremap(region, 8192, 4096, 0, 0);
    if (map_failed(shrunk) || shrunk[0] != 42 || errno != ERANGE) return 6;
    if (munmap(shrunk, 4096) != 0 || errno != ERANGE) return 7;
    return 42;
}
