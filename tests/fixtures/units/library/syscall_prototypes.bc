int main(void) {
    return sizeof(pid_t) != 4 || sizeof(mode_t) != 4 || sizeof(off_t) != 8 ||
           sizeof(time_t) != 8 || sizeof(suseconds_t) != 8 ||
           sizeof(nfds_t) != 8 || sizeof(fd_set) != 128 ||
           sizeof(struct ipc_perm) != 48 || sizeof(struct shmid_ds) != 112 ||
           sizeof(struct itimerval) != 32 || sizeof(struct rusage) != 144 ||
           sizeof(struct semid_ds) != 104 || sizeof(struct msqid_ds) != 120 ||
           sizeof(struct sembuf) != 6 || sizeof(struct flock) != 32 ||
           sizeof(rlim_t) != 8 || sizeof(struct rlimit) != 16 ||
           sizeof(struct timezone) != 8 || sizeof(struct sysinfo) != 112;
}
