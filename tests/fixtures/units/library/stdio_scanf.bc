#include <stdio.h>
#include <string.h>

int main(void)
{
    FILE *f = tmpfile();
    if (!f) return 1;
    if (fwrite("  -42 0x2a hello,3.5!", 1, 21, f) != 21) return 2;
    rewind(f);
    int number = 0;
    int hex = 0;
    char word[8];
    float real = 0;
    int count = -1;
    if (fscanf(f, "%d %i %5[a-z],%f%n", &number, &hex, word, &real, &count) != 4) return 3;
    if (number != -42 || hex != 42 || strcmp(word, "hello") || real != 3.5 || count != 20) return 4;
    if (ftell(f) != 20 || fgetc(f) != '!') return 5;
    if (fscanf(f, "%d", &number) != EOF || !feof(f)) return 6;
    rewind(f);
    if (fscanf(f, " %*d %2s", word) != 1 || strcmp(word, "0x")) return 7;
    if (ftell(f) != 8 || fseek(f, 0, SEEK_CUR) || fgetc(f) != '2') return 8;
    if (fclose(f)) return 9;
    f = tmpfile();
    if (!f) return 10;
    if (fwrite("1,2 -7 0xff 077 2.25 -0x1.8p+1 xyz", 1, 34, f) != 34) return 11;
    rewind(f);
    int a, b;
    signed char small;
    unsigned long large;
    unsigned int octal;
    double d;
    long double extended;
    char tail[4];
    if (fscanf(f, "%d,%d %hhd %lx %o %lf %Lf %3s",
               &a, &b, &small, &large, &octal, &d, &extended, tail) != 8) return 12;
    if (a != 1 || b != 2 || small != -7 || large != 255 || octal != 63 ||
        d != 2.25 || extended != -3.0L || strcmp(tail, "xyz")) return 13;
    if (fclose(f)) return 14;
    f = tmpfile();
    if (!f) return 15;
    if (fwrite("18!abc", 1, 6, f) != 6) return 16;
    rewind(f);
    if (fscanf(f, "%d", &a) != 1 || a != 18 || ftell(f) != 2) return 17;
    char bytes[4];
    if (fread(bytes, 1, 4, f) != 4 ||
        bytes[0] != '!' || bytes[1] != 'a' || bytes[2] != 'b' || bytes[3] != 'c') return 18;
    rewind(f);
    if (fscanf(f, "%d", &a) != 1 || fseek(f, 0, SEEK_CUR) ||
        ftell(f) != 2 || fgetc(f) != '!') return 19;
    if (fseek(f, 0, SEEK_SET) || fscanf(f, "%[a-z]", word) != 0 ||
        fgetc(f) != '1') return 20;
    if (fclose(f)) return 21;
    f = tmpfile();
    if (!f) return 24;
    if (fscanf(f, "%d", &a) != EOF || !feof(f)) return 25;
    clearerr(f);
    if (feof(f) || ferror(f)) return 26;
    for (int i = 0; i < 200; ++i)
        if (fputc('0', f) == EOF) return 27;
    if (fwrite("1.5!", 1, 4, f) != 4) return 28;
    rewind(f);
    if (fscanf(f, "%lf", &d) != 1 || d != 1.5 || fgetc(f) != '!') return 29;
    if (fclose(f)) return 30;
    if (scanf("%d", &a) != 1 || a != 123) return 22;
    if (fread(bytes, 1, 2, stdin) != 2 || bytes[0] != 'x' || bytes[1] != 'y') return 23;
    return 0;
}
