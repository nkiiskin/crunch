#include <sys/mman.h>
#include <fcntl.h>
#include <unistd.h>
#include <errno.h>

int main(int argc, char argv[][]) {
    if (argc != 2) return 1;
    errno = ERANGE;
    char* region = mmap(0, 4096, PROT_READ | PROT_WRITE,
                        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (map_failed(region) || errno != ERANGE) return 2;
    region[0] = (char)42;
    char* grown = mremap(region, 4096, 8192, MREMAP_MAYMOVE, 0);
    if (map_failed(grown) || errno != ERANGE || grown[0] != 42) return 3;
    char* target = mmap(0, 8192, PROT_READ | PROT_WRITE,
                        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (map_failed(target)) return 4;
    char* moved = mremap(grown, 8192, 8192, MREMAP_MAYMOVE | MREMAP_FIXED, target);
    if (map_failed(moved) || moved[0] != 42 || errno != ERANGE) return 5;
    int* number = (void*)moved;
    *number = 1234;
    if (*number != 1234) return 14;
    if (munmap(moved, 8192) != 0 || errno != ERANGE) return 6;

    int fd = open(argv[1], O_RDONLY, 0);
    if (fd < 0) return 7;
    char* file = mmap(0, 4096, PROT_READ, MAP_PRIVATE, fd, 4096);
    if (map_failed(file) || file[0] != 'Z' || errno != ERANGE) return 8;
    if (munmap(file, 4096) != 0 || close(fd) != 0) return 9;
    char* bad = mmap(0, 0, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (!map_failed(bad) || errno != EINVAL) return 10;
    errno = 0;
    bad = mremap(0, 4096, 8192, MREMAP_MAYMOVE, 0);
    if (!map_failed(bad) || errno != EFAULT) return 11;
    errno = 0;
    if (munmap(0, 0) != -1 || errno != EINVAL) return 12;
    if (map_failed(0)) return 13;
    return 42;
}
