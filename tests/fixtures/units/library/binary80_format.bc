#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int via_list(char *buffer, size_t size, const char *format, ...) {
    va_list args;
    va_start(args, format);
    int result = vsnprintf(buffer, size, format, args);
    va_end(args);
    return result;
}

int main(void) {
    char *line = 0, *end = 0;
    size_t capacity = 0;
    char first[6000], second[6000];
    while (getline(&line, &capacity, stdin) >= 0) {
        long double value = strtold(line, &end);
        int a = snprintf(first, sizeof(first), "%Lf|%.17Lg", value, value);
        int b = via_list(second, sizeof(second), "%Lf|%.17Lg", value, value);
        if (a != b || strcmp(first, second))
            return 1;
        puts(first);
        a = snprintf(first, sizeof(first), "%d:%020Lf:%-24.17Lg:%d", 3, value, value, 7);
        b = via_list(second, sizeof(second), "%d:%020Lf:%-24.17Lg:%d", 3, value, value, 7);
        if (a != b || strcmp(first, second))
            return 2;
        puts(first);
        a = snprintf(first, 8, "%Lf", value);
        b = via_list(second, 8, "%Lf", value);
        if (a != b || strcmp(first, second))
            return 3;
        printf("%d:%s\n", a, first);
        printf("printf:%Lf:%.17Lg\n", value, value);
        fprintf(stdout, "fprintf:%Lf:%.17Lg\n", value, value);
    }
    free(line);
    return 0;
}
