#include <stdio.h>
#include <unistd.h>
#include <errno.h>

int main() {
    if (stdin == 0 || stdout == 0 || stderr == 0 ||
        stdin == stdout || stdout == stderr) return 1;
    if (fputc('!', stdin) != EOF || errno != EBADF || ferror(stdin) == 0 ||
        ferror(stdout) != 0 || ferror(stderr) != 0) return 12;
    clearerr(stdin);
    if (fgetc(stdout) != EOF || errno != EBADF || ferror(stdout) == 0 ||
        ferror(stdin) != 0 || ferror(stderr) != 0) return 13;
    clearerr(stdout);
    if (fgetc(stdin) != 'A' || feof(stdin) != 0 || ferror(stdin) != 0 ||
        fgetc(stdin) != EOF || feof(stdin) == 0 || ferror(stdin) != 0) return 2;
    if (fputc('O', stdout) != 'O' || fputc(331, stdout) != 'K' ||
        fputc('E', stderr) != 'E') return 3;
    struct FILE* f = fopen("bytes", "w+");
    if (f == 0 || fputc(255, f) != 255 || fputc(256, f) != 0 ||
        fputc(-1, f) != 255 || fseek(f, 0, SEEK_SET) != 0) return 4;
    if (fgetc(f) != 255 || fgetc(f) != 0 || fgetc(f) != 255 ||
        feof(f) != 0 || fgetc(f) != EOF || feof(f) == 0 || ferror(f) != 0) return 5;
    if (fclose(f) != 0) return 6;
    f = fopen("bytes", "r");
    if (f == 0 || fputc('X', f) != EOF || errno != EBADF ||
        ferror(f) == 0 || feof(f) != 0 || fclose(f) != 0) return 7;
    f = fopen("bytes", "a");
    if (f == 0 || fgetc(f) != EOF || errno != EBADF ||
        ferror(f) == 0 || feof(f) != 0 || fclose(f) != 0) return 8;
    if (fgetc(0) != EOF || errno != EINVAL ||
        fputc(1, 0) != EOF || errno != EINVAL) return 9;
    if (fclose(stdin) != 0 || fclose(stdout) != 0 || fclose(stderr) != 0) return 10;
    if (close(STDIN_FILENO) != -1 || errno != EBADF ||
        close(STDOUT_FILENO) != -1 || errno != EBADF ||
        close(STDERR_FILENO) != -1 || errno != EBADF) return 11;
    return 0;
}
