#include <stdlib.h>
#include <errno.h>

int main() {
    errno = ERANGE;
    char* data = malloc(512);
    if (!data) return 1;
    data[0] = (char)42;
    if (allocator_trim() != 0 || errno != ERANGE || data[0] != 42) return 2;
    free(data);
    if (allocator_trim() != 0 || errno != ERANGE) return 3;
    return 42;
}
