#include <stdio.h>
#include <stdarg.h>
#include <string.h>

int render(char *buffer, size_t capacity, const char *format, ...) {
    va_list arguments;
    va_list copied;
    char second[32];
    va_start(arguments, format);
    va_copy(copied, arguments);
    int count = vsnprintf(buffer, capacity, format, copied);
    va_end(copied);
    int other = vsnprintf(second, sizeof(second), format, arguments);
    va_end(arguments);
    if (count != other || strcmp(buffer, second))
        return -1;
    return count;
}

int main(void) {
    char buffer[32];
    int count = render(buffer, sizeof(buffer), "%d %.*s %.17g", 42, 3, "abcdef", 1.25);
    if (count != 11 || strcmp(buffer, "42 abc 1.25"))
        return 1;
    return 0;
}
