#include <stdio.h>

typedef struct __crunch_va_list_tag va_list[1];

int main(void) {
    long values[1] = {42};
    va_list arguments = {{48, 176, values, 0}};
    char buffer[3];
    int result = vsnprintf(buffer, sizeof(buffer), "%d", arguments);
    if (result != 2 || buffer[0] != '4' || buffer[1] != '2' || buffer[2] != 0)
        return 1;
    return 0;
}
